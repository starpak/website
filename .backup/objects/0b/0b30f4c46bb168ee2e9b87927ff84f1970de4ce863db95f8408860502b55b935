/* ===== MD3 Tokens — 青色系 ===== */
:root {
  --md-primary: #006874;
  --md-on-primary: #ffffff;
  --md-primary-container: #4dd8e9;
  --md-on-primary-container: #001f24;
  --md-secondary: #4a6368;
  --md-on-secondary: #ffffff;
  --md-secondary-container: #cde7ed;
  --md-on-secondary-container: #051f23;
  --md-tertiary: #5d5b7f;
  --md-on-tertiary: #ffffff;
  --md-tertiary-container: #e3dfff;
  --md-on-tertiary-container: #1a1838;
  --md-error: #ba1a1a;
  --md-on-error: #ffffff;
  --md-error-container: #ffdad6;
  --md-on-error-container: #410002;
  --md-background: #f4fbfb;
  --md-on-background: #161d1d;
  --md-surface: #f4fbfb;
  --md-on-surface: #161d1d;
  --md-surface-variant: #dae4e5;
  --md-on-surface-variant: #3f494a;
  --md-outline: #6f797a;
  --md-outline-variant: #bec8c9;
  --md-shadow: #000000;
  --md-surface-tint: #006874;
  --md-surface-container: #e8eff0;
  --md-surface-container-low: #eef5f5;
  --md-surface-container-high: #e2e9ea;
  --md-surface-container-highest: #dde4e4;
  --md-surface-dim: #d5dcdc;
  --md-surface-bright: #f4fbfb;
  --md-inverse-surface: #2b3232;
  --md-inverse-on-surface: #eef5f5;
  --md-inverse-primary: #00bcd4;
  --md-shape-sm: 8px;
  --md-shape-md: 12px;
  --md-shape-lg: 16px;
  --md-shape-xl: 28px;
  --md-shape-full: 9999px;
  --md-elevation-1: 0 1px 3px 1px rgba(0,0,0,.15),0 1px 2px 0 rgba(0,0,0,.3);
  --md-elevation-2: 0 2px 6px 2px rgba(0,0,0,.15),0 1px 2px 0 rgba(0,0,0,.3);
  --md-elevation-3: 0 4px 8px 3px rgba(0,0,0,.15),0 1px 3px 0 rgba(0,0,0,.3);
}

/* ===== 暗色主题 ===== */
@media (prefers-color-scheme: dark) {
  :root {
    --md-primary: #00bcd4;
    --md-on-primary: #00363e;
    --md-primary-container: #004f5a;
    --md-on-primary-container: #4dd8e9;
    --md-secondary: #b1cbd0;
    --md-on-secondary: #1c3438;
    --md-secondary-container: #334b4f;
    --md-on-secondary-container: #cde7ed;
    --md-tertiary: #c7c3ea;
    --md-on-tertiary: #2f2d4e;
    --md-tertiary-container: #454365;
    --md-on-tertiary-container: #e3dfff;
    --md-error: #ffb4ab;
    --md-on-error: #690005;
    --md-error-container: #93000a;
    --md-on-error-container: #ffb4ab;
    --md-background: #0e1515;
    --md-on-background: #dde4e4;
    --md-surface: #0e1515;
    --md-on-surface: #dde4e4;
    --md-surface-variant: #3f494a;
    --md-on-surface-variant: #bec8c9;
    --md-outline: #889293;
    --md-outline-variant: #3f494a;
    --md-shadow: #000000;
    --md-surface-tint: #00bcd4;
    --md-surface-container: #1a2122;
    --md-surface-container-low: #121919;
    --md-surface-container-high: #242b2c;
    --md-surface-container-highest: #2f3637;
    --md-surface-dim: #0e1515;
    --md-surface-bright: #343b3b;
    --md-inverse-surface: #dde4e4;
    --md-inverse-on-surface: #161d1d;
    --md-inverse-primary: #006874;
  }
}

/* ===== 全局重置 ===== */
*,*::before,*::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  background: var(--md-background);
  color: var(--md-on-background);
  line-height: 1.6;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--md-primary); text-decoration: none; transition: color .2s; }
a:hover { color: var(--md-primary-container); }
::selection { background: var(--md-primary); color: var(--md-on-primary); }
img { max-width: 100%; display: block; }

/* ===== 工具类 ===== */
.gradient-text {
  background: linear-gradient(135deg,var(--md-primary),var(--md-primary-container));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 28px; border-radius: var(--md-shape-full);
  font: 500 14px/20px 'Inter',sans-serif;
  cursor: pointer; transition: all .2s; border: none; text-decoration: none;
}
.btn-primary { background: var(--md-primary); color: var(--md-on-primary); }
.btn-primary:hover { box-shadow: var(--md-elevation-2); transform: translateY(-1px); }
.btn-secondary {
  background: transparent; color: var(--md-primary);
  border: 1px solid var(--md-outline);
}
.btn-secondary:hover { background: var(--md-surface-container-high); border-color: var(--md-primary); }
.section-title {
  font: 700 32px/40px 'Inter',sans-serif; text-align: center; margin-bottom: 12px;
}
.section-desc {
  font: 400 16px/24px 'Inter',sans-serif; text-align: center;
  color: var(--md-on-surface-variant); margin-bottom: 48px;
}
