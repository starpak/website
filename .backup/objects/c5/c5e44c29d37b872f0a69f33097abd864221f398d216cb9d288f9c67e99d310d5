  <div class="container nav-inner">
    <div class="nav-logo" onclick="navigate('home')">
      <span>✦</span>
      <span>spak</span>
    </div>
    <div class="nav-links">
      <button class="nav-link active" data-route="home" onclick="navigate('home')">首页</button>
      <button class="nav-link" data-route="projects" onclick="navigate('projects')">项目</button>
      <button class="nav-link" data-route="about" onclick="navigate('about')">关于</button>
      <button class="theme-toggle" onclick="toggleTheme()" title="切换主题">
        <span class="theme-sun">☀️</span>
        <span class="theme-moon">🌙</span>
      </button>
    </div>
  </div>
</div>
<script>
function toggleTheme() {
  const html = document.documentElement
  html.classList.toggle('dark')
  localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light')
}
// 初始化主题
if (localStorage.getItem('theme') === 'dark' ||
    (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
  document.documentElement.classList.add('dark')
}
</script>
